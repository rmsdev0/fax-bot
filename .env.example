# fax-bot environment configuration
# Copy to .env and fill in the secrets. Never commit .env.

# --- Telnyx ---
# API key v2: create in Mission Control Portal -> Account Settings -> Keys & Credentials.
# SECRET - shown once at creation, goes only in .env.
TELNYX_API_KEY=

# Public key for webhook Ed25519 signature verification
# (Portal -> Account Settings -> Keys & Credentials -> Public Key)
TELNYX_PUBLIC_KEY=

# Your Fax API application's connection_id (Portal -> Voice/Fax -> Fax applications),
# used for POST /v2/faxes.
TELNYX_CONNECTION_ID=

# The public number people fax, assigned to that fax application (E.164).
FAX_BOT_NUMBER=+1XXXXXXXXXX

# Optional second number for round-trip testing, assigned to the same app.
# Code ignores inbound faxes addressed to this number (loop guard) -
# it receives fax-bot's replies during round-trip tests.
TEST_FAX_NUMBER=

# Public URL of this server. Telnyx fetches reply PDFs from
# {PUBLIC_BASE_URL}/media/... and webhooks go to {PUBLIC_BASE_URL}/webhooks/telnyx.
# Dev: your ngrok URL (and update the fax app's webhook URL in the portal to match).
PUBLIC_BASE_URL=http://localhost:8000

# Reject unsigned webhooks (requires TELNYX_PUBLIC_KEY). Only disable for
# local experiments where Telnyx can't reach the server anyway.
WEBHOOK_VERIFY=true

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Admin ---
# Required for all /admin/* routes (X-Admin-Token header); they 401 while unset.
ADMIN_TOKEN=

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://faxbot:faxbot@localhost:5432/faxbot
DATA_DIR=data
